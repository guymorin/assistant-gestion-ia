#!/usr/bin/env bash
# Finances - IA
# Lit la configuration des répertoires depuis Finances-config.txt,
# synchronise les données vers les répertoires Finances/<établissement>,
# puis lance Streamlit sur app_finances_tva.py puis ouvre automatiquement l'onglet
# du navigateur sur l'application.
#
# Usage :
#   ./Finances              # port 8502 par défaut
#   FINANCES_RH_PORT=8503 ./Finances

set -u

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

# Chargement de la configuration des répertoires
CONFIG_FILE="./Finances/Finances-config.txt"
if [[ -f "$CONFIG_FILE" ]]; then
    while IFS=':' read -r etablissement chemin_brut; do
        # Ignorer les lignes de commentaire
        [[ "$etablissement" =~ ^[[:space:]]*# ]] && continue
        # Trim whitespace
        etablissement="$(echo "$etablissement" | xargs)"
        chemin_brut="$(echo "$chemin_brut" | xargs)"
        if [[ -n "$etablissement" && -n "$chemin_brut" ]]; then
            # Le champ chemin contient source;cible;mode[;libelle_mail] séparés par des ;
            IFS=';' read -r repo_source repo_cible mode_synch libelle_mail <<< "$chemin_brut"
            # Trim whitespace des champs
            repo_source="$(echo "$repo_source" | xargs)"
            repo_cible="$(echo "$repo_cible" | xargs)"
            mode_synch="$(echo "$mode_synch" | xargs)"
            libelle_mail="$(echo "${libelle_mail:-}" | xargs)"
            if [[ -n "$repo_source" && -n "$repo_cible" && -n "$mode_synch" ]]; then
                # Vérifier que le répertoire source existe
                if [[ -d "$repo_source" ]]; then
                    # Nom du répertoire de destination dans Finances/
                    dest_dir="Finances/${etablissement}"
                    # Créer le répertoire de destination s'il n'existe pas
                    mkdir -p "$dest_dir"
                    # Synchroniser (copier les nouveaux fichiers) depuis la source vers la destination
                    if [[ -d "Finances/${etablissement}" && -d "$repo_source" ]]; then
                        rsync -av --ignore-existing "$repo_source"/ "$dest_dir"/ 2>/dev/null || true
                    fi
                    echo "Configuration chargée : $etablissement -> $repo_source (vers $dest_dir, mode: $mode_synch)"
                else
                    echo "Attention : répertoire source introuvable pour $etablissement : $repo_source" >&2
                fi
            else
                echo "Attention : format de configuration invalide pour $etablissement : $chemin_brut" >&2
            fi
        fi
    done < "$CONFIG_FILE"
else
    echo "Avertissement : fichier de configuration $CONFIG_FILE introuvable." >&2
    echo "Créez-le avec des lignes du format: NOM_ETABLISSEMENT: CHEMIN_SOURCE;CHEMIN_CIBLE;MODE" >&2
fi

PORT="${FINANCES_RH_PORT:-8502}"
URL="http://localhost:${PORT}"
APP_LOG="/tmp/assistant-comptable.log"

open_browser() {
    local url="$1"
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
    elif command -v open >/dev/null 2>&1; then
        open "$url" >/dev/null 2>&1 &
    elif command -v sensible-browser >/dev/null 2>&1; then
        sensible-browser "$url" >/dev/null 2>&1 &
    else
        echo "Ouvrez manuellement l'adresse : $url"
    fi
}

# --- Nettoyage d'éventuel processus Streamlit déjà en cours -----------------

# Tuer tout processus Streamlit existants sur le port cible
if [[ -n "$PORT" ]]; then
    EXISTING_PID=$(lsof -i "tcp:$PORT" 2>/dev/null | grep -v PID | awk 'NR==1{print $2}' || true)
    if [[ -n "$EXISTING_PID" ]]; then
        echo "Un processus Streamlit existe déjà sur le port $PORT (PID $EXISTING_PID), tentative d'arrêt..."
        kill "$EXISTING_PID" 2>/dev/null || true
        # Attendre que le processus s'arrête
        for _ in $(seq 1 10); do
            if ! kill -0 "$EXISTING_PID" 2>/dev/null; then
                break
            fi
            sleep 0.5
        done
        # Forcer l'arrêt si nécessaire
        kill -9 "$EXISTING_PID" 2>/dev/null || true
    fi
fi

# --- Vérifications ---------------------------------------------------------

if [[ ! -x .venv/bin/python ]]; then
    echo "Erreur : environnement .venv introuvable dans $SCRIPT_DIR" >&2
    echo "Créez-le avec :" >&2
    echo "  python3.12 -m venv .venv" >&2
    echo "  .venv/bin/python -m pip install -r requirements-dev.txt" >&2
    exit 1
fi

if [[ ! -f app_finances_tva.py ]]; then
    echo "Erreur : fichier app_finances_tva.py introuvable dans $SCRIPT_DIR" >&2
    exit 1
fi

# --- Ollama ----------------------------------------------------------------
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_LOG="/tmp/ollama-assistant-comptable.log"

if ! curl -fsS --max-time 2 "$OLLAMA_URL/api/tags" >/dev/null 2>&1; then
    if command -v ollama >/dev/null 2>&1; then
        echo "Ollama n'est pas joignable, démarrage..."
        nohup ollama serve >"$OLLAMA_LOG" 2>&1 &
        for _ in $(seq 1 30); do
            curl -fsS --max-time 1 "$OLLAMA_URL/api/tags" >/dev/null 2>&1 && break
            sleep 0.5
        done
        if ! curl -fsS --max-time 1 "$OLLAMA_URL/api/tags" >/dev/null 2>&1; then
            echo "Erreur : impossible de démarrer Ollama (voir $OLLAMA_LOG)." >&2
            exit 1
        fi
    else
        echo "Erreur : ollama est introuvable. Lancez 'ollama serve' manuellement." >&2
        exit 1
    fi
fi

# --- Application déjà lancée ? --------------------------------------------

if curl -fsS --max-time 1 "$URL/_stcore/health" >/dev/null 2>&1; then
    echo "L'application est déjà lancée : $URL"
    open_browser "$URL"
    exit 0
fi

# --- Lancement de Streamlit ------------------------------------------------

echo "Démarrage de Streamlit sur $URL..."
PORTAIL_VUE=finances .venv/bin/python -m streamlit run app_portail.py \
    --server.port "$PORT" \
    --server.headless true \
    --browser.gatherUsageStats false &
APP_PID=$!

cleanup() {
    if kill -0 "$APP_PID" 2>/dev/null; then
        kill "$APP_PID" 2>/dev/null
        wait "$APP_PID" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

# Attente de la disponibilité du serveur (max ~30 s)
READY=0
for _ in $(seq 1 60); do
    if curl -fsS --max-time 1 "$URL/_stcore/health" >/dev/null 2>&1; then
        READY=1
        break
    fi
    if ! kill -0 "$APP_PID" 2>/dev/null; then
        echo "Erreur : Streamlit s'est arrêté avant d'être disponible (voir $APP_LOG)." >&2
        exit 1
    fi
    sleep 0.5
done

if [[ "$READY" -eq 0 ]]; then
    echo "Erreur : le serveur n'a pas répondu dans le délai imparti." >&2
    exit 1
fi

open_browser "$URL"

echo "Application disponible : $URL"
echo "Appuyez sur Ctrl+C pour arrêter."
wait "$APP_PID"
